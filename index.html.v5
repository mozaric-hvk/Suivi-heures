<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calculateur d'Heures</title>
  <style>
    :root {
      --primary: #2563eb;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --border: #e2e8f0;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      justify-content: center;
      padding: 2rem 1rem;
      margin: 0;
    }

    .container {
      background: var(--card);
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 480px;
      border: 1px solid var(--border);
    }

    h1 {
      font-size: 1.25rem;
      margin-top: 0;
      margin-bottom: 1.5rem;
      color: var(--primary);
    }

    .form-group {
      margin-bottom: 1.25rem;
    }

    label {
      display: block;
      font-weight: 500;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
    }

    input[type="number"] {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      box-sizing: border-box;
      font-size: 1rem;
    }

    .info-box {
      background-color: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 0.75rem;
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      border-radius: 0 6px 6px 0;
    }

    .results {
      border-top: 2px dashed var(--border);
      padding-top: 1rem;
      margin-top: 1rem;
    }

    .result-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      font-size: 0.95rem;
    }

    .result-row.total {
      font-weight: bold;
      font-size: 1.1rem;
      color: var(--primary);
      border-top: 1px solid var(--border);
      padding-top: 0.75rem;
    }
  </style>
</head>
<body>

<div class="container">
  <h1>Saisie et Valorisation des Heures</h1>

  <div class="info-box">
    <strong>Paramètres du contrat :</strong><br>
    • Base horaire mensuelle : <strong>121,33 h</strong><br>
    • Taux horaire de base : <strong>13,72 €/h</strong><br>
    • Majoration heures supp. (+25%) : <strong>17,15 €/h</strong>
  </div>

  <form id="hoursForm">
    <div class="form-group">
      <label for="heuresEffectuees">Heures totales effectuées dans le mois :</label>
      <input type="number" id="heuresEffectuees" step="0.25" min="0" placeholder="ex: 140" value="121.33">
    </div>
  </form>

  <div class="results">
    <div class="result-row">
      <span>Heures contractuelles :</span>
      <span id="hBase">121,33 h</span>
    </div>
    <div class="result-row">
      <span>Heures complémentaires (13,72 €) :</span>
      <span id="hCompl">0,00 h (0,00 €)</span>
    </div>
    <div class="result-row">
      <span>Heures supplémentaires (17,15 €) :</span>
      <span id="hSupp">0,00 h (0,00 €)</span>
    </div>
    <div class="result-row total">
      <span>Total valorisé :</span>
      <span id="totalMontant">0,00 €</span>
    </div>
  </div>
</div>

<script>
  const CONSTANTS = {
    BASE_MENSUELLE: 121.33,
    SEUIL_LEGAL: 151.67,
    TAUX_BASE: 13.72,
    TAUX_SUPP: 13.72 * 1.25 // 17.15 €
  };

  const inputHeures = document.getElementById('heuresEffectuees');
  const elHBase = document.getElementById('hBase');
  const elHCompl = document.getElementById('hCompl');
  const elHSupp = document.getElementById('hSupp');
  const elTotal = document.getElementById('totalMontant');

  function calculer() {
    const totalSaisi = parseFloat(inputHeures.value) || 0;
    
    let hCompl = 0;
    let hSupp = 0;

    if (totalSaisi > CONSTANTS.BASE_MENSUELLE) {
      const surplus = totalSaisi - CONSTANTS.BASE_MENSUELLE;
      const maxCompl = CONSTANTS.SEUIL_LEGAL - CONSTANTS.BASE_MENSUELLE; // 30.34 h max

      if (surplus <= maxCompl) {
        hCompl = surplus;
      } else {
        hCompl = maxCompl;
        hSupp = surplus - maxCompl;
      }
    }

    const montantCompl = hCompl * CONSTANTS.TAUX_BASE;
    const montantSupp = hSupp * CONSTANTS.TAUX_SUPP;
    const montantTotal = (Math.min(totalSaisi, CONSTANTS.BASE_MENSUELLE) * CONSTANTS.TAUX_BASE) + montantCompl + montantSupp;

    elHCompl.textContent = `${hCompl.toFixed(2)} h (${montantCompl.toFixed(2)} €)`;
    elHSupp.textContent = `${hSupp.toFixed(2)} h (${montantSupp.toFixed(2)} €)`;
    elTotal.textContent = `${montantTotal.toFixed(2)} €`;
  }

  inputHeures.addEventListener('input', calculer);
  calculer();
</script>

</body>
</html>
